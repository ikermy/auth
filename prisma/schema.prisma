// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum AccountOrigin {
  email
  telegram
}

model User {
  id String @id @default(uuid())
  email String? @unique
  password String
  passwordChangedAt DateTime @default(now())
  role UserRole @default(user)
  origin AccountOrigin @default(email)
  failedLoginAttempts Int @default(0)
  lastLoginAt DateTime?
  lastLoginIp String?
  isActive Boolean @default(true)
  isEmailVerified Boolean @default(false)
  emailVerificationToken String?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  
  // User Username (уникальный изменяемый идентификатор)
  username String? @unique

  // User NickName (неуникальный изменяемый идентификатор для UI)
  nickname String?

  // Загруженная фотография профиля (base64 data URL, см. changeAvatar)
  photoBase64 String?

  // Telegram авторизация
  telegramId String? @unique
  telegramUsername String?
  telegramFirstName String?
  telegramLastName String?
  telegramPhotoUrl String?
  isTelegramVerified Boolean @default(false)

  // Служебный Telegram-логин (placeholder вида tg_...@secure.local).
  // Хранится здесь, а не в email, чтобы освободить email для реального адреса.
  telegramAuth String?
  
  // 2FA поля
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  twoFactorPendingSecret String? // Secret в состоянии pending до подтверждения первого кода
  twoFactorPendingSecretCreatedAt DateTime?
  backupCodes String[] // JSON array of backup codes (хранятся как хеши)
  
  // Seed фраза для доступа к User
  seedPhraseEnabled Boolean @default(false)
  seedPhraseHash String? // Хеш seed фразы
  seedPhraseSalt String? // Соль для seed фразы
  seedPhraseAttempts Int @default(0) // Счетчик попыток
  seedPhraseLockedUntil DateTime? // Блокировка до времени
  seedPhraseLastVerifiedAt DateTime? // Последняя проверка seed фразы
  seedPhraseVerificationCount Int @default(0) // Количество успешных проверок
  
  // Аномалии и безопасность
  anomalyScore Float @default(0.0)
  lastAnomalyAt DateTime?
  trustedDevices String[] // JSON array of trusted device fingerprints
  
  // Шифрование
  encryptedData String? // Зашифрованные дополнительные данные
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  loginAttempts LoginAttempt[]
  sessions Session[]
  securityEvents SecurityEvent[]
  telegramIdentityAudits TelegramIdentityAudit[]
  usernameReservations UsernameReservation[]
  recoveryRequests RecoveryRequest[]

  @@map("users")
}

model LoginAttempt {
  id String @id @default(uuid())
  userId String?
  email String
  ipAddress String
  userAgent String?
  success Boolean
  failureReason String?
  timestamp DateTime @default(now())

  // Связи
  user User? @relation(fields: [userId], references: [id])

  @@index([email, timestamp])
  @@index([ipAddress, timestamp])
  @@map("login_attempts")
}

model Session {
  id String @id @default(uuid())
  userId String
  accessTokenJti String @unique
  refreshTokenJti String @unique
  ipAddress String
  userAgent String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  lastAccessedAt DateTime @default(now())
  expiresAt DateTime

  // Связи
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([accessTokenJti])
  @@index([refreshTokenJti])
  @@map("sessions")
}

model TelegramIdentityAudit {
  id String @id @default(uuid())
  userId String
  eventType String // например: telegram_changed, telegram_linked
  previousData Json // снимок старых Telegram-данных и сопутствующих параметров
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_identity_audit")
}

enum ReservationState {
  active
  expired
  released_by_admin
}

model UsernameReservation {
  id String @id @default(uuid())
  userId String
  username String @unique // резервируемое User username
  state ReservationState @default(active)
  reservedAt DateTime @default(now())
  expiresAt DateTime // конец grace period
  releasedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([state, expiresAt])
  @@map("username_reservations")
}

enum RecoveryStatus {
  pending_review
  approved
  rejected
  cancelled
  needs_review
  granted
}

model RecoveryRequest {
  id String @id @default(uuid())
  userId String
  status RecoveryStatus @default(pending_review)
  reason String? // причина отказа/доп. проверки (фиксирует администратор)
  decidedBy String?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  grantExpiresAt DateTime? // срок действия recovery grant

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("recovery_requests")
}

enum EventType {
  ANOMALY_DETECTED
  TWO_FA_ENABLED
  PASSWORD_CHANGED
  SUSPICIOUS_ACTIVITY
  SUCCESS
  ERROR
  RATE_LIMIT_EXCEEDED
  AUTH_ATTEMPT
  REGISTRATION
  TOKEN_REFRESH
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityEvent {
  id String @id @default(uuid())
  userId String? // nullable: системные события без привязки к User (AUDIT-01)
  eventType EventType
  severity Severity
  description String
  metadata Json? // Дополнительные данные события
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  // Связи
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([eventType, severity])
  @@map("security_events")
}

